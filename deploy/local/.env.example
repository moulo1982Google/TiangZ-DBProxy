DBPROXY_POSTGRES_USER=tiangz
DBPROXY_POSTGRES_PASSWORD=tiangz_dev
DBPROXY_POSTGRES_DB=tiangz
DBPROXY_POSTGRES_PORT=5432
DBPROXY_REDIS_PASSWORD=tiangz_dev
DBPROXY_REDIS_PORT=6379
DBPROXY_PROMETHEUS_PORT=9095
DBPROXY_GRAFANA_PORT=3000
DBPROXY_GRAFANA_ADMIN_USER=admin
DBPROXY_GRAFANA_ADMIN_PASSWORD=tiangz_grafana_dev

# 给 DBProxy 集成测试和本地客户端使用。
DBPROXY_POSTGRES_URL=postgres://tiangz:tiangz_dev@127.0.0.1:5432/tiangz
DBPROXY_REDIS_URL=redis://:tiangz_dev@127.0.0.1:6379/0

# 以下只适用于本机开发；普通启动参数在 configs/local.json，生产密钥必须由密钥系统注入。
DBPROXY_AUTH_TOKEN=tiangz-dbproxy-local-token-2026
