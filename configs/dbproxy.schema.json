{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moulo1982Google/TiangZ-DBProxy/configs/dbproxy.schema.json",
  "title": "TiangZ DBProxy Configuration",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "retryQueue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": { "type": "integer", "minimum": 1, "default": 1 },
        "leaseMs": { "type": "integer", "minimum": 1, "default": 30000 },
        "idleDelayMs": { "type": "integer", "minimum": 1, "default": 250 },
        "baseRetryDelayMs": { "type": "integer", "minimum": 1, "default": 1000 },
        "maxRetryDelayMs": { "type": "integer", "minimum": 1, "default": 60000 },
        "maxAttempts": { "type": "integer", "minimum": 1, "default": 20 }
      }
    }
  },
  "required": ["configVersion", "server", "storage"],
  "properties": {
    "$schema": { "type": "string" },
    "configVersion": { "const": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workerThreads": { "type": "integer", "minimum": 1, "description": "Tokio Runtime工作线程数；省略时使用逻辑CPU数，性能对比时必须显式设置。" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listenAddr", "authTokenEnv"],
      "properties": {
        "listenAddr": { "type": "string", "description": "单个DBProxy实例的监听地址。" },
        "authTokenEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "认证令牌所在的环境变量名。" },
        "maxFrameBytes": { "type": "integer", "minimum": 1, "default": 8388608 },
        "maxPayloadBytes": { "type": "integer", "minimum": 1, "default": 1048576 },
        "handshakeTimeoutMs": { "type": "integer", "minimum": 1, "default": 5000 },
        "shutdownGraceMs": { "type": "integer", "minimum": 1, "default": 5000 }
      }
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "postgresUrlEnv", "redisUrlEnv"],
          "properties": {
            "backend": { "const": "postgresRedis" },
            "postgresUrlEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "redisUrlEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Redis URL for the AOF-backed snapshot backlog and Outbox stream." },
            "cacheRedisUrlEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Optional independent snapshot-cache Redis URL. When omitted, redisUrlEnv is reused for backward compatibility." },
            "shards": { "type": "integer", "minimum": 1, "default": 4 },
            "cacheFallbackConcurrency": { "type": "integer", "minimum": 1, "default": 16 },
            "cacheFallbackTimeoutMs": { "type": "integer", "minimum": 1, "default": 2000 },
            "cacheOperationTimeoutMs": { "type": "integer", "minimum": 1, "default": 200 },
            "cacheFallbackCircuitFailureThreshold": { "type": "integer", "minimum": 1, "default": 5 },
            "cacheFallbackCircuitCooldownMs": { "type": "integer", "minimum": 1, "default": 5000 },
            "cacheFallbackLockLeaseMs": { "type": "integer", "minimum": 1, "default": 3000 },
            "cacheFallbackLockWaitMs": { "type": "integer", "minimum": 1, "default": 1000 },
            "cacheFallbackLockPollMs": { "type": "integer", "minimum": 1, "default": 25 },
            "cacheTtlMs": { "type": "integer", "minimum": 1, "default": 300000, "description": "Fresh lifetime for a positive snapshot cache entry." },
            "cacheTtlJitterMs": { "type": "integer", "minimum": 0, "default": 30000, "description": "Deterministic per-record TTL jitter; zero disables jitter." },
            "cacheNegativeTtlMs": { "type": "integer", "minimum": 0, "default": 5000, "description": "Lifetime for a not-found marker; zero disables negative caching." },
            "cacheStaleWhileRevalidateMs": { "type": "integer", "minimum": 0, "default": 30000, "description": "Additional stale-serving window after freshness expires; zero disables stale-while-revalidate." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend"],
          "properties": {
            "backend": { "const": "memory" },
            "shards": { "type": "integer", "minimum": 1, "default": 4 }
          }
        }
      ]
    },
    "backlog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": { "type": "integer", "minimum": 1, "default": 1 },
        "leaseMs": { "type": "integer", "minimum": 1, "default": 30000 },
        "idleDelayMs": { "type": "integer", "minimum": 1, "default": 20 },
        "failureDelayMs": { "type": "integer", "minimum": 1, "default": 1000 }
      }
    },
    "cacheRepair": {
      "$ref": "#/$defs/retryQueue",
      "description": "PostgreSQL持久缓存修复队列worker；Redis回写失败不会丢失修复意图。"
    },
    "outbox": {
      "$ref": "#/$defs/retryQueue",
      "description": "PostgreSQL事务Outbox worker；事件至少一次发布到Redis Streams。"
    },
    "outboxRelay": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "publishTimeoutMs": { "type": "integer", "minimum": 3000, "maximum": 60000, "default": 5000, "description": "必须比 outbox.leaseMs 至少少 1000ms。" },
        "defaultPublisher": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "publishers": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "backend", "connectionEnv"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "legacy 为保留 ID；更换目标集群必须更换 ID。" },
              "backend": { "enum": ["redisStream", "kafka", "rabbitMq"] },
              "connectionEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "enabled": { "type": "boolean", "default": true }
            },
            "allOf": [{ "if": { "properties": { "backend": { "enum": ["kafka", "rabbitMq"] } } }, "then": { "required": ["enabled"], "properties": { "enabled": { "const": false } } } }]
          }
        },
        "sources": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["producer", "version", "destination"],
            "properties": {
              "producer": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "enabled": { "type": "boolean", "default": true, "description": "未来 MQ 的来源可以先声明为 false，不注册路由、不启用投递。" },
              "version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
              "publisher": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "destination": { "type": "string", "minLength": 1, "maxLength": 256, "description": "完整 Stream 地址；dbproxy:outbox: 前缀保留给旧消息。" }
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filterEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "default": "RUST_LOG" },
        "defaultFilter": { "type": "string", "minLength": 1, "default": "info" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listenAddr": { "type": "string", "description": "Prometheus与健康探针HTTP监听地址；必须仅暴露在本机或运维内网。" }
      }
    }
  }
}
