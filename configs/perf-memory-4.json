{
  "$schema": "./dbproxy.schema.json",
  "configVersion": 1,
  "server": {
    "listenAddr": "127.0.0.1:7810",
    "authTokenEnv": "DBPROXY_AUTH_TOKEN",
    "maxFrameBytes": 8388608,
    "handshakeTimeoutMs": 5000,
    "shutdownGraceMs": 5000
  },
  "runtime": {
    "workerThreads": 4
  },
  "storage": {
    "backend": "memory",
    "shards": 16
  },
  "logging": {
    "filterEnv": "RUST_LOG",
    "defaultFilter": "info"
  }
}
